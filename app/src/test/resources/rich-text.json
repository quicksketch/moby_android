{
  "description": "Shared cases for formatted descriptions. See SPECIFICATIONS.md section 8. 'editable' reads html for the formatted editor with the site's tags, then writes it back with them; a null result means it is edited as raw HTML. 'display' reads html for display, then writes it with the site's tags.",
  "editable": [
    {
      "name": "Plain text",
      "html": "Hello world",
      "tags": [
        "p",
        "br",
        "strong",
        "b",
        "em",
        "i",
        "u",
        "s",
        "del",
        "strike",
        "a"
      ],
      "result": "<p>Hello world</p>"
    },
    {
      "name": "Entities are decoded and encoded again",
      "html": "Tom &amp; Jerry &lt;3",
      "tags": [
        "p",
        "br",
        "strong",
        "b",
        "em",
        "i",
        "u",
        "s",
        "del",
        "strike",
        "a"
      ],
      "result": "<p>Tom &amp; Jerry &lt;3</p>"
    },
    {
      "name": "Newlines outside p end paragraphs",
      "html": "One\nTwo\n\nThree",
      "tags": [
        "strong",
        "em",
        "a"
      ],
      "result": "One\n\nTwo\n\nThree"
    },
    {
      "name": "Paragraphs",
      "html": "<p>One</p>\n<p>Two</p>",
      "tags": [
        "p",
        "br",
        "strong",
        "b",
        "em",
        "i",
        "u",
        "s",
        "del",
        "strike",
        "a"
      ],
      "result": "<p>One</p>\n<p>Two</p>"
    },
    {
      "name": "Whitespace inside p collapses",
      "html": "<p>  a\n  b  </p>",
      "tags": [
        "p",
        "br",
        "strong",
        "b",
        "em",
        "i",
        "u",
        "s",
        "del",
        "strike",
        "a"
      ],
      "result": "<p>a b</p>"
    },
    {
      "name": "br ends paragraphs",
      "html": "a<br>b<br />c",
      "tags": [
        "p",
        "br",
        "strong",
        "em",
        "del",
        "a"
      ],
      "result": "<p>a</p>\n<p>b</p>\n<p>c</p>"
    },
    {
      "name": "Nested styles",
      "html": "<strong>bold <em>both</em></strong><em> italic</em>",
      "tags": [
        "p",
        "br",
        "strong",
        "b",
        "em",
        "i",
        "u",
        "s",
        "del",
        "strike",
        "a"
      ],
      "result": "<p><strong>bold <em>both</em></strong><em> italic</em></p>"
    },
    {
      "name": "Preferred tags replace alternatives",
      "html": "<b>x</b> <i>y</i>",
      "tags": [
        "p",
        "br",
        "strong",
        "b",
        "em",
        "i",
        "u",
        "s",
        "del",
        "strike",
        "a"
      ],
      "result": "<p><strong>x</strong> <em>y</em></p>"
    },
    {
      "name": "Alternative tags when the site keeps only those",
